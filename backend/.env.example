PORT=5000

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Get this from Render Dashboard → PostgreSQL → Info → External Database URL
# Example: postgresql://college_user:password@dpg-xxx.render.com:5432/college_db
DATABASE_URL=postgresql://user:password@host:5432/college_db

# ── JWT ────────────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string (32+ characters)
# You can generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Cloudinary (free at cloudinary.com) ───────────────────────────────────────
# Optional: Only needed for avatar/document upload feature
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay (free test keys at dashboard.razorpay.com) ───────────────────────
# Optional: Only needed for payment feature
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx

# ── Frontend URL (for CORS) ────────────────────────────────────────────────────
# Set this to your Vercel deployment URL (comma-separated for multiple URLs)
# Example: https://college-management-beryl.vercel.app
FRONTEND_URL=https://college-management-beryl.vercel.app

# ── Environment ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database SSL (optional override) ──────────────────────────────────────────
# Auto-detected based on DATABASE_URL. Set manually only if needed.
# DB_SSL=true
