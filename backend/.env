PORT=5000

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Get this from Render Dashboard > PostgreSQL > Connection String
DATABASE_URL=postgresql://user:password@host:5432/college_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Cloudinary (free at cloudinary.com) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay (free test keys at dashboard.razorpay.com) ───────────────────────
# Frontend build needs the publishable key id (used client-side)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_TKNzk4dM7Q70ZlZ

# Backend needs both the key id + secret (used server-side to create orders)
RAZORPAY_KEY_ID=rzp_test_TKNzk4M7Q70ZlZ
RAZORPAY_KEY_SECRET=zKE9PU8a8udx39LPdmbQiY3Dk

# Backend port (CRA proxies /api to this via the "proxy" field in package.json)
PORT=5000

# ── Frontend URL (for CORS) ────────────────────────────────────────────────────
FRONTEND_URL=https://college-management-beryl.vercel.app

# ── Environment ────────────────────────────────────────────────────────────────
NODE_ENV=development
